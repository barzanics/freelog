# ============================================================
#  WorkTracker 6 — .gitignore
#  build.spec is intentionally tracked — only outputs are ignored.
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.installed.cfg
*.egg
build/
dist/
*.so

# ---------- Virtual envs ----------
.venv/
venv/
env/

# ---------- Testing / coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ---------- Type checkers / linters ----------
.mypy_cache/
.ruff_cache/

# ---------- IDE / editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- WorkTracker runtime data ----------
# Real data lives in %APPDATA%/WorkTracker or ~/.local/share/worktracker;
# anything written here during dev/test is user-private.
*.log
logs/
backups/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.wtpack
data/logs/
data/backups/
data/cache/
data/tmp/
data/*.db
data/*.db-wal
data/*.db-shm

# ---------- Secrets ----------
credentials.json
client_secret*.json
token.json
.env
.env.*
!.env.example

# ---------- Screenshots ----------
hourly_screenshots/
screenshots/
!docs/**/screenshots/

# ---------- Packaging output ----------
packaging/build/
packaging/dist/
output/
release/

# ---------- Temp ----------
*.tmp
*.bak